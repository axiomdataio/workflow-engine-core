{
  "$id": "https://solutionforest.dev/workflow.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "steps"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "metadata": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/stepObject" },
          { "$ref": "#/$defs/stepListItem" }
        ]
      }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "stepBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": { "type": ["string", "null"], "minLength": 1 },
        "parameters": { "type": "object" },
        "config": { "type": "object" },
        "timeout": { "type": ["string", "null"], "pattern": "^\\d+[smhd]$|^\\d+$" },
        "retry_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "compensation": { "type": ["string", "null"] },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stepObject": {
      "allOf": [
        { "$ref": "#/$defs/stepBase" },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" }
          }
        }
      ]
    },
    "stepListItem": {
      "$ref": "#/$defs/stepBase"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "condition": { "type": "string" },
        "metadata": { "type": "object" }
      }
    }
  }
}

